/// telemetry.fl — VCS telemetry integration via qkit-telemetry
/// lex polyqlabs/poly-git/integration

import qkit_telemetry from "qkit-telemetry@^0.2.0"

circuit emit_push_latency(latency_ms: u64)
    lex polyqlabs/poly-git/integration
    precision C
{
    qkit_telemetry::emit_gauge("vcs.push.latency_ms", latency_ms, "{}", "poly-git.push")
}

circuit emit_pull_latency(latency_ms: u64)
    lex polyqlabs/poly-git/integration
    precision C
{
    qkit_telemetry::emit_gauge("vcs.pull.latency_ms", latency_ms, "{}", "poly-git.pull")
}

circuit emit_push_event(repo_id: bytes(32), user_id: bytes(16), objects: u64)
    lex polyqlabs/poly-git/integration
    precision C
{
    qkit_telemetry::emit_event("vcs.push", concat(repo_id, ":", user_id, ":", objects))
}

circuit check_push_baseline(latency_ms: u64) -> bool
    lex polyqlabs/poly-git/integration
    precision B
{
    let check = qkit_telemetry::check_baseline("vcs.push.latency_ms", latency_ms)
    check.within_baseline
}
