/// sanitize.fl — VCS content sanitization via qkit-sanitize
/// lex polyqlabs/poly-git/integration

import qkit_sanitize from "qkit-sanitize@^0.2.0"

circuit sanitize_commit_message(message: bytes(8192)) -> bytes(8192)
    lex polyqlabs/poly-git/integration
    precision A
    observe metrics: [commit_messages_sanitized]
{
    let result = qkit_sanitize::sanitize(message)
    result.sanitized_data
}

circuit detect_pii_in_blob(content: bytes(65536)) -> bool
    lex polyqlabs/poly-git/integration
    precision A
    observe metrics: [blob_pii_scans, pii_detected]
{
    let detections = qkit_sanitize::detect_only(content)
    len(detections) > 0
}
