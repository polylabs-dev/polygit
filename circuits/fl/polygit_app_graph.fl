/// Spec: specs/POLYGIT_CE_APP_GRAPH_SPEC.md
/// PolyGit App Graph — defines 13 ModuleNode declarations for PolyGit,
/// registers intra-graph dependency edges and cross-graph bridges to es-vcs,
/// PolyKit CI, and PolyDocs.
///
/// Epic: polygit#TBD (CE + App Graph Integration)
/// govern lex polylabs/polygit

lex polylabs/polygit

@target software
@codegen_targets ["wasm", "rust"]

import "core/deployment/module_stratum.fl" {
    ModuleNode, ModuleEdge, SemVer, CompilationReceipt, ResourceBudget8D,
    CsrStorage, ModuleType, AperturePartition, ModuleState, RolloutState,
    PersistencePolicy, OfflineCachePolicy, EntitlementTier, EnforcementMode,
    SLATier, EDGE_REQUIRES, EDGE_BRIDGE_TO,
    module_graph_add_module, module_graph_add_edge,
    graph_add_node, graph_add_edge,
}

import "core/deployment/cross_graph_edges.fl" {
    EDGE_GOVERNANCE_OBSERVE, EDGE_COMPILED_BY,
    GovernanceObserveEdge, CompilationProvenanceEdge,
    module_graph_add_governance_observe_edge,
    module_graph_add_compilation_provenance_edge,
}

// ── Constants ──────────────────────────────────────────────────────────────────

const POLYGIT_VERSION_MAJOR: u32 = 0
const POLYGIT_VERSION_MINOR: u32 = 2
const POLYGIT_VERSION_PATCH: u32 = 0
const POLYGIT_APP_LEX: string = "polylabs/polygit"
const POLYGIT_MODULE_COUNT: u32 = 13

// ═══════════════════════════════════════════════════════════════════════════════
// Internal helper — common ModuleNode construction
// ═══════════════════════════════════════════════════════════════════════════════

circuit make_polygit_module(
    name: string, partition: u8, sla: u8, budget: ResourceBudget8D
) -> ModuleNode
    lex polylabs/polygit
    @status production
    @precision D
{
    let ver = SemVer { major: POLYGIT_VERSION_MAJOR, minor: POLYGIT_VERSION_MINOR,
        patch: POLYGIT_VERSION_PATCH, pre_release: "" }
    let receipt = CompilationReceipt {
        source_hash: bytes(32, 0), compiler_version: ver,
        output_hash: bytes(32, 0), prime_device_id: Option::None,
        compilation_timestamp: 0, reproducible_verified: false,
        receipt_signature: bytes(4627, 0),
    }

    ModuleNode {
        name: name,
        version_major: POLYGIT_VERSION_MAJOR, version_minor: POLYGIT_VERSION_MINOR,
        version_patch: POLYGIT_VERSION_PATCH, version_pre: "",
        module_type: ModuleType::SmartCircuit as u8,
        content_hash: bytes(32, 0), signature_chain: bytes(0),
        aperture_partition: partition,
        role_set: ["Developer", "Admin"],
        required_entitlement: EntitlementTier::Pro as u8,
        classification_domains: [], max_classification_level: 0,
        compilation_receipt: receipt,
        source_hash: bytes(32, 0),
        compiler_version_major: POLYGIT_VERSION_MAJOR,
        compiler_version_minor: POLYGIT_VERSION_MINOR,
        prime_device_id: bytes(0), reproducible_verified: false,
        resource_budget: budget,
        budget_enforcement_mode: EnforcementMode::Hard as u8,
        state: ModuleState::Active as u8,
        rollout_state: RolloutState::Canary as u8,
        canary_target: Option::None,
        persistence: PersistencePolicy::Persistent as u8,
        offline_cache_policy: OfflineCachePolicy::CacheAndVerify as u8,
        max_staleness_seconds: 3600, sla_tier: sla,
        preferred_locality: "",
        created_at_ms: 0, updated_at_ms: 0,
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
// §1  Module Definitions (13 modules)
// ═══════════════════════════════════════════════════════════════════════════════

circuit polygit_branch_module() -> ModuleNode
    lex polylabs/polygit  @status production  @precision D
    observe metrics: [module_name]  meters [compute_cycles]
{
    make_polygit_module("polygit_branch", AperturePartition::Backend as u8,
        SLATier::Premium as u8,
        ResourceBudget8D { execution: 6000, hash_ops: 200, bandwidth: 2000,
            storage: 1000, observe_events: 200, proofs: 10, consensus: 5, memory: 4096 })
}

