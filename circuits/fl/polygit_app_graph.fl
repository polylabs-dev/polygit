// ═══════════════════════════════════════════════════════════════════════════════
// §2  Graph Registration (13 modules, EDGE_REQUIRES)
// ═══════════════════════════════════════════════════════════════════════════════

circuit polygit_app_graph_register(graph: CsrStorage) -> CsrStorage
    lex polylabs/polygit
    @status production
    @precision B
    @attested true
    observe metrics: [polygit_module_count, polygit_edge_count, register_latency_ns]
    meters [compute_cycles, memory_bytes]
{
    let (g, id_branch) = module_graph_add_module(graph, polygit_branch_module())
    let (g, id_ci) = module_graph_add_module(g, polygit_ci_module())
    let (g, id_commit) = module_graph_add_module(g, polygit_commit_module())
    let (g, id_doc_review) = module_graph_add_module(g, polygit_document_review_module())
    let (g, id_governance) = module_graph_add_module(g, polygit_governance_module())
    let (g, id_issue) = module_graph_add_module(g, polygit_issue_module())
    let (g, id_lfs) = module_graph_add_module(g, polygit_lfs_module())
    let (g, id_metering) = module_graph_add_module(g, polygit_metering_module())
    let (g, id_health) = module_graph_add_module(g, polygit_platform_health_module())
    let (g, id_rbac) = module_graph_add_module(g, polygit_rbac_module())
    let (g, id_repository) = module_graph_add_module(g, polygit_repository_module())
    let (g, id_review) = module_graph_add_module(g, polygit_review_module())
    let (g, id_repo_graph) = module_graph_add_module(g, polygit_repo_graph_module())

    let ver = "0.2.0"
    let vc = ">=0.2.0"

    // polygit_branch -> polygit_repository
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polygit_branch", source_version: ver,
        target_module: "polygit_repository", target_version_constraint: vc, metadata: bytes(0),
    }, id_branch, id_repository)

    // polygit_branch -> polygit_commit
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polygit_branch", source_version: ver,
        target_module: "polygit_commit", target_version_constraint: vc, metadata: bytes(0),
    }, id_branch, id_commit)

    // polygit_ci -> polygit_commit
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polygit_ci", source_version: ver,
        target_module: "polygit_commit", target_version_constraint: vc, metadata: bytes(0),
    }, id_ci, id_commit)

    // polygit_ci -> polygit_branch
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polygit_ci", source_version: ver,
        target_module: "polygit_branch", target_version_constraint: vc, metadata: bytes(0),
    }, id_ci, id_branch)

    // polygit_commit -> polygit_repository
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polygit_commit", source_version: ver,
        target_module: "polygit_repository", target_version_constraint: vc, metadata: bytes(0),
    }, id_commit, id_repository)

    // polygit_document_review -> polygit_review
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polygit_document_review", source_version: ver,
        target_module: "polygit_review", target_version_constraint: vc, metadata: bytes(0),
    }, id_doc_review, id_review)

    // polygit_governance -> polygit_rbac
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polygit_governance", source_version: ver,
        target_module: "polygit_rbac", target_version_constraint: vc, metadata: bytes(0),
    }, id_governance, id_rbac)

    // polygit_governance -> polygit_branch
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polygit_governance", source_version: ver,
        target_module: "polygit_branch", target_version_constraint: vc, metadata: bytes(0),
    }, id_governance, id_branch)

    // polygit_issue -> polygit_repository
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polygit_issue", source_version: ver,
        target_module: "polygit_repository", target_version_constraint: vc, metadata: bytes(0),
    }, id_issue, id_repository)

    // polygit_lfs -> polygit_repository
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polygit_lfs", source_version: ver,
        target_module: "polygit_repository", target_version_constraint: vc, metadata: bytes(0),
    }, id_lfs, id_repository)

    // polygit_lfs -> polygit_commit
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polygit_lfs", source_version: ver,
        target_module: "polygit_commit", target_version_constraint: vc, metadata: bytes(0),
    }, id_lfs, id_commit)

    // polygit_review -> polygit_commit
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polygit_review", source_version: ver,
        target_module: "polygit_commit", target_version_constraint: vc, metadata: bytes(0),
    }, id_review, id_commit)

    // polygit_review -> polygit_branch
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polygit_review", source_version: ver,
        target_module: "polygit_branch", target_version_constraint: vc, metadata: bytes(0),
    }, id_review, id_branch)

    // polygit_review -> polygit_rbac
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polygit_review", source_version: ver,
        target_module: "polygit_rbac", target_version_constraint: vc, metadata: bytes(0),
    }, id_review, id_rbac)

    // polygit_repo_graph -> polygit_repository
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polygit_repo_graph", source_version: ver,
        target_module: "polygit_repository", target_version_constraint: vc, metadata: bytes(0),
    }, id_repo_graph, id_repository)

    // polygit_repo_graph -> polygit_commit
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polygit_repo_graph", source_version: ver,
        target_module: "polygit_commit", target_version_constraint: vc, metadata: bytes(0),
    }, id_repo_graph, id_commit)

    // polygit_metering -> polygit_repository
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polygit_metering", source_version: ver,
        target_module: "polygit_repository", target_version_constraint: vc, metadata: bytes(0),
    }, id_metering, id_repository)

    // polygit_platform_health -> polygit_metering
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polygit_platform_health", source_version: ver,
        target_module: "polygit_metering", target_version_constraint: vc, metadata: bytes(0),
    }, id_health, id_metering)

    g
}

// ═══════════════════════════════════════════════════════════════════════════════
// §3  Cross-Graph Bridge Edges
// ═══════════════════════════════════════════════════════════════════════════════

/// Bridge edges: PolyGit -> es-vcs (commit wire protocol), PolyKit CI (pipeline
/// dispatch), PolyDocs (document review integration).
circuit polygit_register_bridge_edges(graph: CsrStorage) -> CsrStorage
    lex polylabs/polygit
    @status production
    @precision B
    @attested true
    observe metrics: [bridge_edge_count]
    meters [compute_cycles]
{
    let id_commit = find_polygit_module_id(graph, "polygit_commit")
    let id_ci = find_polygit_module_id(graph, "polygit_ci")
    let id_doc_review = find_polygit_module_id(graph, "polygit_document_review")

    // BRIDGE_TO: polygit_commit -> es-vcs es_vcs_core (commit wire protocol)
    let bridge_vcs = serialize(BridgeEdgeData {
        source_lex: POLYGIT_APP_LEX, source_module: "polygit_commit",
        target_lex: "core/vcs", target_module: "es_vcs_core",
        bridge_type: "commit_wire_protocol", timestamp_ms: 0,
    }) as bytes
    let (g, bid1) = graph_add_node(graph, 0xB0, bridge_vcs)
    let g = graph_add_edge(g, id_commit, bid1, EDGE_BRIDGE_TO, bridge_vcs)

    // BRIDGE_TO: polygit_ci -> PolyKit CI polykit_ci_runner (pipeline dispatch)
    let bridge_ci = serialize(BridgeEdgeData {
        source_lex: POLYGIT_APP_LEX, source_module: "polygit_ci",
        target_lex: "polylabs/polykit/ci", target_module: "polykit_ci_runner",
        bridge_type: "pipeline_dispatch", timestamp_ms: 0,
    }) as bytes
    let (g, bid2) = graph_add_node(g, 0xB0, bridge_ci)
    let g = graph_add_edge(g, id_ci, bid2, EDGE_BRIDGE_TO, bridge_ci)

    // BRIDGE_TO: polygit_document_review -> PolyDocs polydocs_review (doc review)
    let bridge_docs = serialize(BridgeEdgeData {
        source_lex: POLYGIT_APP_LEX, source_module: "polygit_document_review",
        target_lex: "polylabs/polydocs", target_module: "polydocs_review",
        bridge_type: "document_review", timestamp_ms: 0,
    }) as bytes
    let (g, bid3) = graph_add_node(g, 0xB0, bridge_docs)
    let g = graph_add_edge(g, id_doc_review, bid3, EDGE_BRIDGE_TO, bridge_docs)

    g
}

// ═══════════════════════════════════════════════════════════════════════════════
// §4  Governance Edges
// ═══════════════════════════════════════════════════════════════════════════════

/// Register GOVERNANCE_OBSERVE edges for all 13 PolyGit modules.
circuit polygit_register_governance_edges(
    graph: CsrStorage,
    governance_lex: string
) -> CsrStorage
    lex polylabs/polygit
    @status production
    @precision B
    @attested true
    observe metrics: [governance_edge_count]
    meters [compute_cycles]
{
    let modules = [
        "polygit_branch", "polygit_ci", "polygit_commit",
        "polygit_document_review", "polygit_governance", "polygit_issue",
        "polygit_lfs", "polygit_metering", "polygit_platform_health",
        "polygit_rbac", "polygit_repository", "polygit_review",
        "polygit_repo_graph",
    ]

    let g = graph
    for name in modules {
        let module_id = find_polygit_module_id(g, name)
        g = module_graph_add_governance_observe_edge(g, GovernanceObserveEdge {
            observer_lex: governance_lex, observer_module: "governance_core",
            observed_lex: POLYGIT_APP_LEX, observed_module: name,
            observe_scope: "full", read_only: true,
            witness_chain_required: false, refresh_interval_ms: 60000,
        }, module_id)
    }
    g
}

// ═══════════════════════════════════════════════════════════════════════════════
// Internal helpers
// ═══════════════════════════════════════════════════════════════════════════════

data BridgeEdgeData : polylabs/polygit/bridge v1 {
    source_lex: string,
    source_module: string,
    target_lex: string,
    target_module: string,
    bridge_type: string,
    timestamp_ms: u64,
}

circuit find_polygit_module_id(graph: CsrStorage, name: string) -> u32
    lex polylabs/polygit
    @status production
    @precision D
{
    for i in 0..graph.num_nodes {
        let node_data = graph.node_data[i]
        let module = deserialize(node_data) as ModuleNode
        if module.name == name {
            return i
        }
    }
    0xFFFFFFFF
}

// ── Metrics Store ──────────────────────────────────────────────────────────────

store series polygit_app_graph_metrics
    lex polylabs/polygit/metrics
{
    operation: string key
    module_count: u32
    edge_count: u32
    register_latency_ns: u64
    bridge_edge_count: u32
    governance_edge_count: u32
}

// ── Golden Tests ───────────────────────────────────────────────────────────────

#[test]
circuit test_polygit_app_graph_register()
    lex polylabs/polygit  @status test
{
    let graph = CsrStorage::empty()
    let result = polygit_app_graph_register(graph)
    assert result.num_nodes == POLYGIT_MODULE_COUNT
    assert result.num_edges >= 18
}

#[test]
circuit test_polygit_bridge_edges()
    lex polylabs/polygit  @status test
{
    let graph = CsrStorage::empty()
    let graph = polygit_app_graph_register(graph)
    let result = polygit_register_bridge_edges(graph)
    let bridge_count = count_edges_of_type(result, EDGE_BRIDGE_TO)
    assert bridge_count == 3
}

#[test]
circuit test_polygit_governance_edges()
    lex polylabs/polygit  @status test
{
    let graph = CsrStorage::empty()
    let graph = polygit_app_graph_register(graph)
    let result = polygit_register_governance_edges(graph, "core/governance")
    let gov_count = count_edges_of_type(result, EDGE_GOVERNANCE_OBSERVE)
    assert gov_count == POLYGIT_MODULE_COUNT
}

#[test]
circuit test_polygit_module_lookup()
    lex polylabs/polygit  @status test
{
    let graph = CsrStorage::empty()
    let graph = polygit_app_graph_register(graph)
    let id = find_polygit_module_id(graph, "polygit_commit")
    assert id != 0xFFFFFFFF
    let missing = find_polygit_module_id(graph, "nonexistent")
    assert missing == 0xFFFFFFFF
}
