/// manifest.fl — SPARK signing for VCS operations via qkit-identity
/// lex polyqlabs/poly-git/signing

import qkit_identity from "qkit-identity@^0.2.0"

circuit derive_vcs_keys(master_seed: bytes(32)) -> qkit_identity::DerivedKeys
    lex polyqlabs/poly-git/signing
    precision A
    observe metrics: [vcs_key_derivations]
{
    qkit_identity::derive_keys(master_seed, "q-git-v1")
}

circuit sign_push_manifest(
    manifest: PushManifest,
    signing_key: bytes(4896)
) -> bytes(4627)
    lex polyqlabs/poly-git/signing
    precision A
    observe metrics: [push_manifests_signed]
{
    let message = sha3_256(concat(manifest.repo_id, manifest.pusher_id, manifest.timestamp))
    qkit_identity::sign_message(signing_key, message)
}

circuit verify_push_signature(
    manifest: PushManifest,
    public_key: bytes(2592)
) -> bool
    lex polyqlabs/poly-git/signing
    precision A
    observe metrics: [push_signatures_verified]
{
    let message = sha3_256(concat(manifest.repo_id, manifest.pusher_id, manifest.timestamp))
    qkit_identity::verify_signature(public_key, message, manifest.signature)
}

circuit create_vcs_app_context() -> qkit_identity::AppContext
    lex polyqlabs/poly-git/signing
    precision C
{
    qkit_identity::create_app_context("poly-git", "q-git-v1", "polyqlabs.git")
}
