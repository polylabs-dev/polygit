/// rate_limit.fl — VCS-specific rate limiting using qkit-rate-limiter
/// lex polyqlabs/poly-git/access
///
/// Import qkit-rate-limiter from marketplace dependency.

import qkit_rate_limiter from "qkit-rate-limiter@^0.2.0"

circuit check_vcs_rate(
    user_id: bytes(16),
    operation: bytes(64)
) -> bool
    lex polyqlabs/poly-git/access
    precision A
    observe metrics: [rate_checks, rate_denials]
{
    let result = qkit_rate_limiter::check_rate(user_id, operation, "poly-git")
    if result.allowed {
        qkit_rate_limiter::record_operation(user_id, operation)
    }
    result.allowed
}
